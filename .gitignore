# NightwingGameSim - Git Ignore

# ============================================
# Environment & Secrets
# ============================================
.env
.env.local
.env.*.local
*.key
secrets/

# ============================================
# Python
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.venv

# ============================================
# IDE & Editors
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# ============================================
# Testing & Coverage
# ============================================
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/
coverage.xml
*.cover

# ============================================
# Type checking
# ============================================
.mypy_cache/
.dmypy.json
dmypy.json

# ============================================
# GameBoy Development
# ============================================
# Compiled ROM files (keep in out/ but don't track)
*.gb
*.gbc

# GBDK intermediate files
*.o
*.lst
*.map
*.sym
*.ihx
*.adb
*.asm
*.noi
*.rst

# Working directory contents (temporary files)
wkdir/*.c
wkdir/*.o
wkdir/*.gb
wkdir/err.txt
wkdir/*.lst
wkdir/*.map
wkdir/*.sym

# ============================================
# Models & Large Files
# ============================================
# Don't commit large model files
*.gguf
*.ggml
*.bin
models/
.cache/

# HuggingFace cache
.huggingface/

# ============================================
# Generated Outputs
# ============================================
# Source archives (optionally track these)
# src/*.c

# Compiled outputs (optionally track some examples)
# out/*.gb

# ============================================
# Logs
# ============================================
*.log
logs/

# ============================================
# Documentation builds
# ============================================
docs/_build/
docs/.doctrees/
site/

# ============================================
# Jupyter Notebooks
# ============================================
.ipynb_checkpoints/
*.ipynb

# ============================================
# Benchmarks & Evaluation
# ============================================
benchmark_results/
evaluation_outputs/
