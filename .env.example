# NightwingGameSim Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# API Keys
# ============================================

# Anthropic API Key (required for Claude backend)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# HuggingFace Token (optional, for downloading models)
# Get yours at: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your_huggingface_token_here

# ============================================
# GBDK Configuration
# ============================================

# Path to GBDK installation (optional if using default ./gbdk)
# GBDK_ROOT=/usr/local/gbdk

# ============================================
# Claude Model Configuration
# ============================================

# Claude model to use (default: claude-sonnet-4-20250514)
# Options: claude-sonnet-4-20250514, claude-3-5-sonnet-20241022, claude-3-opus-20240229
CLAUDE_MODEL=claude-sonnet-4-20250514

# Maximum tokens for Claude responses (default: 16384)
CLAUDE_MAX_TOKENS=16384

# Temperature for generation (0.0 = deterministic, 1.0 = creative)
CLAUDE_TEMPERATURE=0.0

# ============================================
# Local Model Configuration
# ============================================

# Path to local Llama model (GGUF format)
# LOCAL_MODEL_PATH=/path/to/Meta-Llama-3-8B-Instruct.gguf

# ============================================
# RAG Configuration
# ============================================

# Embedding model for RAG (default: BAAI/bge-small-en-v1.5)
RAG_EMBED_MODEL=BAAI/bge-small-en-v1.5

# LLM model for RAG (default: meta-llama/Llama-3.2-3B-Instruct)
RAG_LLM_MODEL=meta-llama/Llama-3.2-3B-Instruct

# ============================================
# Generation Settings
# ============================================

# Maximum compilation retry attempts (default: 3)
MAX_RETRIES=3

# Verbose output (true/false)
VERBOSE=false

